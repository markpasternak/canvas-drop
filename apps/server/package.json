{
  "name": "@canvas-drop/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --conditions=node-dist dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "purge": "tsx scripts/purge-deleted.ts",
    "backup": "tsx src/index.ts backup",
    "restore": "tsx src/index.ts restore"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@aws-sdk/client-s3": "^3.1161.0",
