    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "ai": "^7.0.159",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
