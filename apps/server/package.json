  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  }
