    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^2.0.9",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "ai": "^6.0.226",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
