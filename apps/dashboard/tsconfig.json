{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    // Deliberately NO "node" here: browser app code must not see node globals —
    // a `process.env` read in a component failing to compile is the cheapest
    // enforcement of the "config is the only process.env reader" rule. Tests
    // (which legitimately use node APIs) typecheck via tsconfig.test.json.
    "types": ["vite/client", "@testing-library/jest-dom"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/test"]
}
